# Copy to frontend/.env if you need to override the defaults.
# Anything prefixed VITE_ is inlined into the browser bundle -- never put a
# secret here. The frontend holds no credentials of any kind.

# Where the dev server proxies /api. Defaults to http://127.0.0.1:8000.
VITE_API_TARGET=http://127.0.0.1:8000

# Only set this when deploying the built bundle somewhere the proxy does not
# exist; it becomes the absolute API base URL. Leave unset in development.
# VITE_API_BASE=https://your-api-host/api
