# Copy to backend/.env and fill in. NEVER commit the real .env.
# The backend starts and the demo runs fine with none of these set --
# persistence falls back to an in-process store.

# --- Supabase (optional) ----------------------------------------------------
# Project URL from Supabase -> Project Settings -> Data API.
SUPABASE_URL=

# SERVICE ROLE key from Supabase -> Project Settings -> API Keys.
# Server-side only. It bypasses Row Level Security -- never expose it to the
# browser or put it in any VITE_* variable.
SUPABASE_SERVICE_KEY=

# The users.id the backend writes rows against. Matches the seed row created
# by supabase/schema.sql.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Simulated market defaults ----------------------------------------------
# Seed values for the simulated chain. Replace this whole block with real
# oracle / gas / DEX providers when wiring up a live integration.
DEFAULT_ETH_PRICE=3000
DEFAULT_GAS_PRICE_GWEI=20
DEFAULT_DEX_LIQUIDITY_USD=2000000
